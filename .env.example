# Copy to .env and edit. Never commit .env or anything in secrets/.
# Secrets can be given as NAME=value or NAME_FILE=/path (file wins).

# ---------------------------------------------------------------- safety
# keep true; only BROKER=paper is allowed while true
PAPER_ONLY=true
BROKER=paper
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ACK=
TRADOVATE_ENABLED=false
# Lucid = prop/evaluation -> adapter refuses
TRADOVATE_ACCOUNT_IS_PROP_OR_EVALUATION=true

# ---------------------------------------------------------------- webhook
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
WEBHOOK_TOKEN=
ADMIN_TOKEN=
# optional second factor sent in the alert body
WEBHOOK_PASSPHRASE=
# TradingView's 4 published webhook IPs
ENFORCE_IP_ALLOWLIST=true
# true only behind your own reverse proxy. docker-compose.yml forces it on, with
# TRUSTED_PROXIES limited to this PC and Docker Desktop, so the IP allowlist
# works through cloudflared and Caddy.
TRUST_PROXY_HEADERS=false
MAX_SIGNAL_AGE_SECONDS=90
ALLOWED_STRATEGY_VERSIONS=V25-webhook.1
ALLOWED_BOT_IDS=V25-MNQ-1
# true only to keep the old prototype payload working
ALLOW_LEGACY_SCHEMA=false

# ---------------------------------------------------------------- risk (broker-sourced)
ACCOUNT_START_BALANCE=50000
MAX_CONTRACTS=2
MAX_TRADE_RISK_USD=200
# reject | reduce (shrink qty to fit limits; changes sizing vs backtest)
RISK_SIZING_MODE=reject
COST_RESERVE_PER_CONTRACT_USD=8
RISK_ENTRY_SLIPPAGE_TICKS=2
MAX_ENTRY_DEVIATION_TICKS=8
# V26 only: minimum reward:risk of the liquidity target (cannot be below 2.0)
MIN_REWARD_RISK=2.0
DAILY_LOSS_LIMIT_USD=450
MAX_DRAWDOWN_USD=2000
# trailing_eod | intraday_trailing | static
DRAWDOWN_MODE=trailing_eod
DRAWDOWN_SAFETY_BUFFER_USD=400
MAX_TRADES_PER_DAY=2
ENTRY_WINDOW_START=08:30
ENTRY_WINDOW_END=14:30
FLATTEN_TIME=14:30
HOLIDAYS=2026-11-26,2026-12-25
MAX_QUOTE_AGE_SECONDS=90
ACCOUNT_STATE_MAX_AGE_SECONDS=10

# ---------------------------------------------------------------- contracts
SYMBOL_ROOT=MNQ
ROLL_DAYS_BEFORE_EXPIRY=8
MIN_DAYS_TO_EXPIRY=2

# ---------------------------------------------------------------- paper simulator
# per side; matches V25's backtest commission
PAPER_COMMISSION_PER_CONTRACT=1.50
# matches V25's backtest slippage=2
PAPER_SLIPPAGE_TICKS=2
PAPER_BOOK_DEPTH=5
PAPER_LIMIT_TRADE_THROUGH=true

# ---------------------------------------------------------------- ops
# flatten | log
TV_EXIT_ACTION=flatten
# alert if TradingView bars stop during the session (0 = off)
TV_HEARTBEAT_MAX_AGE_SECONDS=180
# Slack/Discord/generic incoming webhook (secret)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=slack
LOG_LEVEL=INFO
# Only for the optional Caddy profile (docker compose --profile caddy up -d).
# Not used with a Cloudflare Tunnel.
DOMAIN=bot.example.com
